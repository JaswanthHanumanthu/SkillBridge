# Database backups and local database files; keep schema, migrations, and seeds.
database/backups/
*.dump
*.backup
*.bak
*.sql.gz
*.sqlite
*.sqlite3
*.db

# Logs, temporary files, and local-only state
logs/
*.log
*.tmp
*.temp
tmp/
temp/
