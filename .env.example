# PostgreSQL Connection URL (replace placeholder; do not commit credentials)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/skillbridge

# FastAPI/Uvicorn settings
DEBUG=1
PORT=8000
# Generate a unique random value locally; never use this placeholder as-is.
SECRET_KEY=replace-with-a-long-random-secret
# Set to 1 behind HTTPS in production.
SESSION_COOKIE_SECURE=0
# Local platform administrator bootstrap. Configure privately in .env;
# these placeholders are not valid credentials.
ADMIN_USERNAME=replace-with-admin-username
ADMIN_PASSWORD=replace-with-local-admin-password

# Optional server-side BridgeMate fallback. Keep the real key in .env only.
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
BRIDGEMATE_FAQ_MATCH_THRESHOLD=68

# Optional comma-separated origins only when the frontend is hosted separately.
# This project serves frontend and API from one origin, so production can leave it empty.
CORS_ORIGINS=
